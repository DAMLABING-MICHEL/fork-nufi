<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('partials/header.ejs', {pageTitle: "Nufi | Login"}); %>
    <link rel="stylesheet" href="assets/css/login-page.css">
</head>
<body>
    <div class="container" id="main-container">
        <div class="form-container sign-up-container">
            <form action="/user/register" method="post" onsubmit="handleSignupSubmit(event)">
                <h1>Create Account</h1>
                <div class="social-container">
                    <a href="#" class="social"><i class="fab fa-facebook-f"></i></a>
                    <a href="#" class="social"><i class="fab fa-x-twitter"></i></a>
                    <a href="#" class="social"><i class="fab fa-linkedin-in"></i></a>
                </div>
                <span>or fill your information to register</span>
                <div class="position-relative w-100">
                    <input
                        type="text" 
                        name="username" 
                        placeholder="Username" required
                        value="<%= formState?.data?.username %>" />
                    <% if (!!formState?.errors["username"]) { %>
                        <div 
                            class="position-absolute text-danger error-flag"
                            data-bs-toggle="tooltip" 
                            data-bs-placement="top" 
                            title="<%= formState?.errors["username"] %>"
                        >
                            <i class="fa-solid fa-circle-exclamation"></i>
                        </div>
                    <% } %>
                </div>
                <div class="d-flex gap-2">
                    <div class="flex-1 position-relative">
                        <input 
                            type="password" 
                            name="password"
                            placeholder="Password" required 
                            value="<%= formState?.data?.password %>"/>
                        <% if (!!formState?.errors["password"]) { %>
                            <div 
                                class="position-absolute text-danger error-flag"
                                data-bs-toggle="tooltip" 
                                data-bs-placement="top" 
                                title="<%= formState?.errors["password"] %>"
                            >
                                <i class="fa-solid fa-circle-exclamation"></i>
                            </div>
                        <% } %>
                    </div>
                    <div class="flex-1 position-relative">
                        <input 
                            type="password" 
                            name="passwordConfirm" 
                            placeholder="Confirm pass..." required 
                            value="<%= formState?.data?.password %>"/>
                    </div>
                </div>
                <div class="d-flex gap-2">
                    <div class="flex-1 position-relative">
                        <input 
                            type="text" 
                            name="lastName" 
                            placeholder="Last name" required 
                            value="<%= formState?.data?.lastName %>"/>
                        <% if (!!formState?.errors["lastName"]) { %>
                            <div 
                                class="position-absolute text-danger error-flag"
                                data-bs-toggle="tooltip" 
                                data-bs-placement="top" 
                                title="<%= formState?.errors["lastName"] %>"
                            >
                                <i class="fa-solid fa-circle-exclamation"></i>
                            </div>
                        <% } %>
                    </div>
                    <div class="flex-1 position-relative">
                        <input 
                            type="text" 
                            name="firstName" 
                            placeholder="First name" 
                            value="<%= formState?.data?.firstName %>"/>
                        <% if (!!formState?.errors["firstName"]) { %>
                            <div 
                                class="position-absolute text-danger error-flag"
                                data-bs-toggle="tooltip" 
                                data-bs-placement="top" 
                                title="<%= formState?.errors["firstName"] %>"
                            >
                                <i class="fa-solid fa-circle-exclamation"></i>
                            </div>
                        <% } %>
                    </div>
                </div>
                <div class="position-relative w-100">
                    <input 
                        type="email" 
                        name="email" 
                        placeholder="Email"
                        value="<%= formState?.data?.email %>"/>
                    <% if (!!formState?.errors["email"]) { %>
                        <div 
                            class="position-absolute text-danger error-flag"
                            data-bs-toggle="tooltip" 
                            data-bs-placement="top" 
                            title="<%= formState?.errors["email"] %>"
                        >
                            <i class="fa-solid fa-circle-exclamation"></i>
                        </div>
                    <% } %>
                </div>
                <input type="hidden" name="formType" value="register" id="<%= formState?.data?.formType === 'register'? 'formType' : undefined %>"/>
                <button type="submit">Sign Up</button>
            </form>
        </div>
        <div class="form-container sign-in-container">
            <form action="/user/login" method="post" onsubmit="handleSigninSubmit(event)">
                <h1>Sign in</h1>
                <div class="social-container">
                    <a href="#" class="social"><i class="fab fa-facebook-f"></i></a>
                    <a href="#" class="social"><i class="fab fa-x-twitter"></i></a>
                    <a href="#" class="social"><i class="fab fa-linkedin-in"></i></a>
                </div>
                <span>or use your account</span>
                <input 
                    type="text" required
                    name="login" 
                    placeholder="Username or email"
                    value="<%= formState?.data?.login %>"/>
                <input 
                    type="password" required
                    name="password" 
                    placeholder="Password"
                    value="<%= formState?.data?.password %>"/>
                <!-- <a href="#">Forgot your password?</a> -->
                <input type="hidden" name="formType" value="login" id="<%= formState?.data?.formType === 'login'? 'formType' : undefined %>"/>
                <button type="submit">Sign In</button>
            </form>
        </div>
        <div class="overlay-container">
            <div class="overlay">
                <div class="overlay-panel overlay-left">
                    <h1>Welcome Back!</h1>
                    <p>To keep connected, please login with your personal info</p>
                    <button class="ghost" id="sign-in-btn">Sign In</button>
                </div>
                <div class="overlay-panel overlay-right">
                    <h1>Hello!</h1>
                    <p>Enter your personal details and start journey with <span>Nufi</span></p>
                    <button class="ghost" id="sign-up-btn">Sign Up</button>
                </div>
            </div>
        </div>
    </div>

    <%- include('partials/footer.ejs'); %>
    <script src="assets/js/login-page.js"></script>
    <script>
        var serverMessage = '<%- JSON.stringify(message) %>';
    </script>
</body>
</html>